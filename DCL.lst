  1790    0855    LD	A,0x55
  1791    0257    SUBA	0x57
  1792    1D03    SNZB	0x3,2
  1793    2F96    JP	0x796
  1794    0854    LD	A,0x54
  1795    0256    SUBA	0x56
  1796    1C03    SNZB	0x3,0
  1797    2FA0    JP	0x7A0
  1798    0854    LD	A,0x54
  1799    02D6    SUBR	0x56
  179A    0855    LD	A,0x55
  179B    1C03    SNZB	0x3,0
  179C    03D7    DECR	0x57
  179D    02D7    SUBR	0x57
  179E    1459    SETB	0x59,0
  179F    1003    CLRB	0x3,0
  17A0    0CD5    RRCR	0x55
  17A1    0CD4    RRCR	0x54
  17A2    0BD8    SZDECR	0x58
  17A3    2F8D    JP	0x78D
  17A4    085A    LD	A,0x5A
