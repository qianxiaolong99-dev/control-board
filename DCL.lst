17:               		*d++ = *s++;
18:               	TBLPTR = tmp;
19:               	return d1;
20:               }
21:               
22:               #else
23:               
24:               #include	<string.h>
25:               
26:               void *
27:               memcpy(void * d1, const void * s1, register size_t n)
28:               {
29:               
30:               	register char *		d;
31:               	register const char *	s;
32:               	register unsigned char tmp;
33:               
34:               	s = s1;
35:               	d = d1;
36:               	while(n--) {
37:               		tmp = *s++;
38:               		*d++ = tmp;
39:               	}
40:               	return d1;
41:               }
