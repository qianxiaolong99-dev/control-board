587:              /***********************************************
588:              函数名称：Memory_Write
589:              函数功能：写数据/程序寄存器
590:              入口参数：Addr - 写入地址
591:              		  Value - 写入数值
592:              出口参数：返回值 0 - 写操作错误 1 - 写完毕
593:              备注：
594:              1.写闪存程序空间，执行完写操作指令后，处理器会使内部操作暂停，时间非固定精准。所以写时效性较高的程序时，需要特别注意处理好时间。
595:              2.写程序EE过程中需要暂时关闭中断，以保证写EE时序中的写55H和写AAH能够连续进行，否则将有可能写错，并且写EE的可靠工作电压范围为3V以上。
596:              ************************************************/
597:              bit Memory_Write(unsigned char Addr, unsigned char Value)
  1FD3    00CF    LD	0x4F,A
598:              {
599:              	static volatile bit B_GIE_On;
600:              	static volatile unsigned char i = 0;
601:              
602:              	B_GIE_On = 0;							//记录进来前是否已经开启中断
  1FD4    1321    CLRB	0x21,6
603:              	if (GIE)
  1FD5    1B8B    SZB	0xB,7
604:              		B_GIE_On = 1;
  1FD6    1721    SETB	0x21,6
605:              
606:              	//将要写入的地址放入EEADDR寄存器
607:              	EEADR = Addr;
  1FD7    1703    SETB	0x3,6
  1FD8    008D    LD	0xD,A
608:              	EEDAT = Value;						//将要写入的数据给EEPROM的数据寄存器
  1FD9    1303    CLRB	0x3,6
  1FDA    084E    LD	A,0x4E
  1FDB    1703    SETB	0x3,6
  1FDC    008C    LD	0xC,A
609:              	EECON1 = 0;
  1FDD    019B    CLR	0x1B
610:              	EEPGD = 0;							//访问数据存储器
  1FDE    139B    CLRB	0x1B,7
611:              	EECON1 | = 0x30;					//烧写时间10ms,时间非固定精准,用户可自定义
  1FDF    3030    LDIA	0x30
  1FE0    049B    ORR	0x1B
  1FE1    0064    CLRWDT
612:              	asm("clrwdt");
613:              
614:              
615:              	WREN = 1;								//允许写周期
  1FE2    1283    CLRB	0x3,5
  1FE3    1703    SETB	0x3,6
  1FE4    151B    SETB	0x1B,2
616:              	GIE = 0;								//关闭中断
  1FE5    138B    CLRB	0xB,7
617:              
618:              	while (GIE)
  1FE6    1F8B    SNZB	0xB,7
  1FE7    2FEE    JP	0x7EE
619:              	{
620:              		GIE = 0;							//确保中断已关闭
  1FE8    138B    CLRB	0xB,7
621:              		if (0 == --i)
  1FE9    1683    SETB	0x3,5
  1FEA    1303    CLRB	0x3,6
  1FEB    0BC7    SZDECR	0x47
  1FEC    2FE6    JP	0x7E6
  1FED    0008    RET
  1FEE    0064    CLRWDT
622:              			return 0;
623:              	}
624:              	asm("clrwdt");
625:              
626:              	EECON2 = 0x55;							//给EECON2写入0x55
  1FEF    3055    LDIA	0x55
  1FF0    1283    CLRB	0x3,5
  1FF1    1703    SETB	0x3,6
  1FF2    009C    LD	0x1C,A
627:              	EECON2 = 0xaa;							//给EECON2写入0xaa
  1FF3    30AA    LDIA	0xAA
  1FF4    009C    LD	0x1C,A
628:              	WR = 1;									//启动写周期
  1FF5    149B    SETB	0x1B,1
  1FF6    0000    NOP
  1FF7    0000    NOP
  1FF8    0064    CLRWDT
629:              	asm("nop");
630:              	asm("nop");
631:              	asm("clrwdt");
632:              	WREN = 0;								//禁止写入
  1FF9    1283    CLRB	0x3,5
  1FFA    1703    SETB	0x3,6
  1FFB    111B    CLRB	0x1B,2
633:              	if (B_GIE_On)							//若原来已开启中断的就开启中断	
  1FFC    1303    CLRB	0x3,6
  1FFD    1B21    SZB	0x21,6
634:              		GIE = 1;
  1FFE    178B    SETB	0xB,7
635:              
636:              	if (WRERR)	return 0;				//写操作错误							
637:              	else		return 1;				//写完毕
638:              }
