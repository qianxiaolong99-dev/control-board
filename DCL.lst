  1DC7    0187    CLR	0x7
12:               	PORTD = 0;
  1DC8    0188    CLR	0x8
13:               	INTCON = 0x00;   //中断寄存器清零
  1DC9    018B    CLR	0xB
  1DCA    0064    CLRWDT
14:               	asm("clrwdt");   //清除看门狗
15:               	OPTION_REG = 0;  //预分频器OPTION_REG=0，及设定：1由端口的各个锁存值使能PORTB上拉；2INT引脚下降沿触发中断；
  1DCB    1683    SETB	0x3,5
  1DCC    1303    CLRB	0x3,6
  1DCD    0181    CLR	0x1
16:               	//3内部指令周期时钟(FsYS/4)【规定设备内部的单条指令执行时间】；4外部时钟源时的计数边沿（仅在 T0CS=1 时有效）TOCKI 引脚 由低变高 时 Timer0 加 1（无效）
17:               	//5预分频器分给Timer0;6 Bit2~Bit0=0,Timer0 分频为1：2（及Timer0 的计数时钟 = (Fosc/4) ÷ 2）【Fosc为内部振荡器频率8MHz】
18:               	PIR1 = 0;        //清除外设中断请求标志寄存器
  1DCE    1283    CLRB	0x3,5
  1DCF    018C    CLR	0xC
19:               	PIR2 = 0;        //外设中断请求寄存器为PIR1和PIR2。当有中断条件产生时，无论对应的中断允许位或全局允许位GIE的
  1DD0    018D    CLR	0xD
20:               	//状态如何，中断标志位都将置1。用户软件应在允许一个中断之前，确保先将相应的中断标志位清零。
21:               	WDTCON = 0x01;   //启动看门狗，软件强制打开看门狗定时器（WDT）
  1DD1    3001    LDIA	0x1
  1DD2    1683    SETB	0x3,5
22:               	
23:               	TRISA = 0B00000000;//PORTA的数据方向寄存器，PORTA引脚被全部设置为输出
24:               	TRISB = 0B00100000;//PORTB的数据方向寄存器，RB0引脚被设置为输入，其他为输出（RXD设置为输入，及允许信号输入，通讯端口）
25:               	TRISC = 0B00000000;//PORTC的数据方向寄存器，RBC引脚被全部设置为输出
26:               	TRISD = 0B00000000;//RD2 NTC （原有的）？；	PORTD的数据方向寄存器，RBD引脚被全部设置为输出
  1DD3    2604    CALL	0x604
27:               	OSCCON = 0x71;    //系统时钟配置：0x71，01110001，111：Fsys=Fosc/1；1：内部振荡器用作系统时钟
  1DD4    3071    LDIA	0x71
  1DD5    008F    LD	0xF,A
28:               	//Fosc为内部振荡器频率8MHz，Fsys为系统工作频率
29:               	PIE1 = 0;		  //外设中断允许寄存器有PIE1和PIE2，在允许任何外设中断前，必须先将INTCON寄存器的PEIE位置1
  1DD6    018C    CLR	0xC
30:               	PIE2 = 0;		  //外设中断允许寄存器有PIE1和PIE2全部先置0
  1DD7    018D    CLR	0xD
31:               	IOCB = 0;		  //PORTB电平变化中断寄存器IOCB，0：禁止电平变化中断，RB引脚变化不会引起中断
  1DD8    0196    CLR	0x16
32:               	WPUA = 0B00000000;//禁止RA引脚上拉
  1DD9    1283    CLRB	0x3,5
  1DDA    1703    SETB	0x3,6
  1DDB    0187    CLR	0x7
33:               	WPUB = 0B00100000;//使能RB3引脚上拉，禁止RB其他引脚上拉
  1DDC    3020    LDIA	0x20
  1DDD    1683    SETB	0x3,5
  1DDE    1303    CLRB	0x3,6
  1DDF    0095    LD	0x15,A
34:               	WPUC = 0B00000000;//同RA引脚
  1DE0    1283    CLRB	0x3,5
  1DE1    1703    SETB	0x3,6
  1DE2    0188    CLR	0x8
35:               	WPUD = 0B00000000;
  1DE3    1683    SETB	0x3,5
  1DE4    1303    CLRB	0x3,6
  1DE5    018E    CLR	0xE
  1DE6    0008    RET
36:               }
