  162D    1703    SETB	0x3,6
  162E    008D    LD	0xD,A
651:              	EEPGD = 0;							//访问数据存储器
  162F    139B    CLRB	0x1B,7
652:              	RD = 1;									//允许读操作
  1630    141B    SETB	0x1B,0
  1631    0000    NOP
  1632    0000    NOP
653:              	asm("nop");
654:              	asm("nop");
655:              
656:              	return EEDAT;
  1633    1283    CLRB	0x3,5
  1634    1703    SETB	0x3,6
  1635    080C    LD	A,0xC
  1636    0008    RET
657:              }
