4:                
5:                void Set_LED_Moudle()
6:                {
7:                	LEDCON0 = (0x40 | FRENQUENCY);			//使能LED,禁止LCD,设置频率
8:                	LEDCON0 |= ((C_COMSEL_COM & 0x03) << 4);
9:                	COMEN = C_LED_COM;
10:               	SEGEN0 = C_LED_SEG0;
11:               	SEGEN1 = C_LED_SEG1;
12:               	SEGEN2 = C_LED_SEGCUR;
13:               }
14:               
15:               void Led_Moudle_Device()
16:               {
17:               	//设置LED内部显示RAM的值
18:               	Set_Addr_Value(C_LED_SEGA | 0X80, 0x01);	//设置SEGA
19:               #if SEG_NUMBER >=2
20:               	Set_Addr_Value(C_LED_SEGB | 0X80, 0x02);	//设置SEGB
21:               #endif
22:               #if SEG_NUMBER >=3
23:               	Set_Addr_Value(C_LED_SEGC | 0X80, 0x04);	//设置SEGC
24:               #endif
25:               #if SEG_NUMBER >=4
26:               	Set_Addr_Value(C_LED_SEGD | 0X80, 0x08);	//设置SEGD
27:               #endif
28:               #if SEG_NUMBER >=5
29:               	Set_Addr_Value(C_LED_SEGE | 0X80, 0x10);	//设置SEGE
30:               #endif
31:               #if SEG_NUMBER >=6
32:               	Set_Addr_Value(C_LED_SEGF | 0X80, 0x20);	//设置SEGF
33:               #endif
34:               #if SEG_NUMBER >=7
35:               	Set_Addr_Value(C_LED_SEGG | 0X80, 0x40);	//设置SEGG
36:               #endif
37:               #if SEG_NUMBER >=8
38:               	Set_Addr_Value(C_LED_SEGP | 0X80, 0x80);	//设置SEGP
39:               #endif
40:               #if SEG_NUMBER >=9
41:               	Set_Addr_Value(C_LED_SEGH | 0X80, 0x100);	//设置SEG9
42:               #endif
43:               #if SEG_NUMBER >=10
44:               	Set_Addr_Value(C_LED_SEGI | 0X80, 0x200);	//设置SEG10
45:               #endif
46:               #if SEG_NUMBER >=11
47:               	Set_Addr_Value(C_LED_SEGJ | 0X80, 0x400);	//设置SEG11
48:               #endif
49:               
50:               	LEDCON1 = 0x20;							//SEG口输出LCDDATA的数据
51:               }
52:               
53:               void Set_Addr_Value(uchar Addr, uint Mask)
54:               {
55:               	uchar data = 0;
56:               	LEDADD = (uchar)(Addr | ((C_COMSEL_COM & 0x04) << 3));
57:               
58:               	if (DispData[0] & Mask)
59:               		BSET(data, C_LED_COM0);
60:               		//BSET(data, C_LED_COM1);
61:               #if COM_NUMBER >=2
62:               	if (DispData[1] & Mask)
63:               		BSET(data, C_LED_COM2);
64:               #endif
65:               #if COM_NUMBER >=3
66:               	if (DispData[2] & Mask)
67:               		BSET(data, C_LED_COM3);
68:               #endif
69:               #if COM_NUMBER >=4
70:               	if (DispData[3] & Mask)
71:               		BSET(data, C_LED_COM0);
72:               #endif
73:               #if COM_NUMBER >=5
74:               	if (DispData[4] & Mask)
75:               		BSET(data, C_LED_COM4);
76:               #endif
77:               #if COM_NUMBER >=6
78:               	if (DispData[5] & Mask)
79:               		BSET(data, C_LED_COM5);
80:               #endif
81:               #if COM_NUMBER >=7
82:               	if (DispData[6] & Mask)
83:               		BSET(data, C_LED_COM6);
84:               #endif
85:               	LEDDATA = data;
86:               }
87:               
88:               // 旋钮状态枚举
89:               typedef enum {
90:                   KNOB_STOP = 0,  // 静止
91:                   KNOB_CW = 1,  // 顺时针旋转
92:                   KNOB_CCW = 2   // 逆时针旋转
93:               } KnobDirTypeDef;
94:               
95:               volatile bit KnobA,KnobB;
96:               volatile uchar now_state;
97:               volatile uchar update_state;
98:               volatile uchar knob_last_state;
99:               #define KNOB_STABLE_TIMES 2
100:              volatile uchar knob_stable_count;
101:              
102:              /**
103:                * @brief  旋钮扫描函数（放在主循环里轮询调用）
104:                * @retval KNOB_STOP/KNOB_CW/KNOB_CCW
105:                */
106:              KnobDirTypeDef Knob_Scan(void)
107:              {
108:              	KnobDirTypeDef dir = KNOB_STOP;
109:                  // 读取当前A、B相电平
110:                  //KnobA = Knob_ReadPin(KNOB_A_PIN);
111:                  //KnobB = Knob_ReadPin(KNOB_B_PIN);
112:              
113:                  now_state = ((uchar)KnobA << 1) | (uchar)KnobB;
114:              
115:                  if (now_state == update_state)
116:                  {
117:                      knob_stable_count++;
118:                      if (knob_stable_count >= KNOB_STABLE_TIMES)//状态稳定
119:                      {
120:                          if ((knob_last_state == 0x03 && now_state == 0x02) || (knob_last_state == 0x00 && now_state == 0x01))
121:                          {
122:                              dir = KNOB_CW;   // 正转
123:                          }
124:                          if ((knob_last_state == 0x02 && now_state == 0x03) || (knob_last_state == 0x01 && now_state == 0x00))
125:                          {
126:                              dir = KNOB_CCW;  // 反转
127:                          }
128:                          knob_last_state = now_state;
129:                      }
130:                  }
131:                  else
132:                  {
133:                      knob_stable_count = 0;  // 状态变化，重置消抖
134:                      update_state = now_state;
135:                  }
136:              
137:                  return dir;
138:              }
