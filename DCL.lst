69:               void Init_ram(void)
70:               {
71:               	Set_Usart_Async();
  1D93    25A2    CALL	0x5A2
  1D94    0064    CLRWDT
72:               	asm("clrwdt");		//把看门狗清零，防止因上电后未清狗而意外复位；
73:               	PIE2 = 0;    		//把外设中断使能寄存器2全部清零，关闭所有相关中断；
  1D95    1683    SETB	0x3,5
  1D96    1303    CLRB	0x3,6
  1D97    018D    CLR	0xD
74:               	PIE1 = 0B00000010;  //允许TMR2与PR2匹配中断；
  1D98    3002    LDIA	0x2
  1D99    008C    LD	0xC,A
75:               	PR2 = 125;				//设 Timer2 周期寄存器，中断周期 = PR2 × TMR2 时钟周期，下将TMR2设置为125us中断，两个参数共同决定中断周期
  1D9A    307D    LDIA	0x7D
  1D9B    0092    LD	0x12,A
76:               	T2CON = 5;				//T2CON = 0000 0101，000：1/1后分频比；1使能定时器2；01：预分频值为4	
  1D9C    3005    LDIA	0x5
  1D9D    1283    CLRB	0x3,5
  1D9E    0092    LD	0x12,A
77:               	INTCON = 0xC0;			//INTCON =1100 0000，允许全局中断，允许外设中断，（及允许PIE1，PIE2赋值）使能中断
  1D9F    30C0    LDIA	0xC0
  1DA0    008B    LD	0xB,A
  1DA1    0008    RET
78:               }
